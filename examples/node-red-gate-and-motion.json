[
  {
    "id": "eufy-gateway-examples",
    "type": "tab",
    "label": "Eufy Mega Security examples",
    "disabled": false,
    "info": "Replace the example entity IDs and filenames before deploying."
  },
  {
    "id": "eufy-ha-server",
    "type": "server",
    "name": "Home Assistant",
    "version": 5,
    "addon": true,
    "rejectUnauthorizedCerts": true,
    "ha_boolean": "y|yes|true|on|home|open",
    "connectionDelay": true,
    "cacheJson": true,
    "heartbeat": false,
    "heartbeatInterval": 30,
    "areaSelector": "friendlyName",
    "deviceSelector": "friendlyName",
    "entitySelector": "friendlyName",
    "statusSeparator": "at: ",
    "statusYear": "hidden",
    "statusMonth": "short",
    "statusDay": "numeric",
    "statusHourCycle": "h23",
    "statusTimeFormat": "h:m",
    "enableGlobalContextStore": true
  },
  {
    "id": "gate-open-trigger",
    "type": "server-state-changed",
    "z": "eufy-gateway-examples",
    "name": "Gate opened",
    "server": "eufy-ha-server",
    "version": 6,
    "outputs": 1,
    "exposeAsEntityConfig": "",
    "entities": {
      "entity": ["binary_sensor.gate_open"],
      "substring": [],
      "regex": []
    },
    "outputInitially": false,
    "stateType": "str",
    "ifState": "on",
    "ifStateType": "str",
    "ifStateOperator": "is",
    "outputOnlyOnStateChange": true,
    "for": 0,
    "forType": "num",
    "forUnits": "minutes",
    "ignorePrevStateNull": true,
    "ignorePrevStateUnknown": true,
    "ignorePrevStateUnavailable": true,
    "ignoreCurrentStateUnknown": true,
    "ignoreCurrentStateUnavailable": true,
    "outputProperties": [],
    "x": 170,
    "y": 100,
    "wires": [["record-doorbell"]]
  },
  {
    "id": "record-doorbell",
    "type": "api-call-service",
    "z": "eufy-gateway-examples",
    "name": "Record Doorbell for 15 seconds",
    "server": "eufy-ha-server",
    "version": 7,
    "debugenabled": false,
    "action": "eufy_event_gateway.record_clip",
    "floorId": [],
    "areaId": [],
    "deviceId": [],
    "entityId": ["camera.doorbell"],
    "labelId": [],
    "data": "{\"filename\": \"/media/eufy/gate_\" & $fromMillis($millis(), \"[Y0001][M01][D01]-[H01][m01][s01]\") & \".mp4\", \"duration\": 15}",
    "dataType": "jsonata",
    "mergeContext": "",
    "mustacheAltTags": false,
    "outputProperties": [],
    "queue": "none",
    "blockInputOverrides": true,
    "x": 500,
    "y": 100,
    "wires": [[]]
  },
  {
    "id": "example-camera-motion-trigger",
    "type": "server-state-changed",
    "z": "eufy-gateway-examples",
    "name": "Example camera motion detected",
    "server": "eufy-ha-server",
    "version": 6,
    "outputs": 1,
    "exposeAsEntityConfig": "",
    "entities": {
      "entity": ["binary_sensor.example_camera_motion"],
      "substring": [],
      "regex": []
    },
    "outputInitially": false,
    "stateType": "str",
    "ifState": "on",
    "ifStateType": "str",
    "ifStateOperator": "is",
    "outputOnlyOnStateChange": true,
    "for": 0,
    "forType": "num",
    "forUnits": "minutes",
    "ignorePrevStateNull": true,
    "ignorePrevStateUnknown": true,
    "ignorePrevStateUnavailable": true,
    "ignoreCurrentStateUnknown": true,
    "ignoreCurrentStateUnavailable": true,
    "outputProperties": [],
    "x": 180,
    "y": 180,
    "wires": [["snapshot-example-camera"]]
  },
  {
    "id": "snapshot-example-camera",
    "type": "api-call-service",
    "z": "eufy-gateway-examples",
    "name": "Capture a fresh example camera snapshot",
    "server": "eufy-ha-server",
    "version": 7,
    "debugenabled": false,
    "action": "eufy_event_gateway.capture_snapshot",
    "floorId": [],
    "areaId": [],
    "deviceId": [],
    "entityId": ["camera.example_camera"],
    "labelId": [],
    "data": "{\"filename\": \"/media/eufy/example_camera_\" & $fromMillis($millis(), \"[Y0001][M01][D01]-[H01][m01][s01]\") & \".jpg\"}",
    "dataType": "jsonata",
    "mergeContext": "",
    "mustacheAltTags": false,
    "outputProperties": [],
    "queue": "none",
    "blockInputOverrides": true,
    "x": 510,
    "y": 180,
    "wires": [[]]
  }
]
